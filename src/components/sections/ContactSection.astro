---
import { Mail, Phone } from "@lucide/astro";
import LogoLinkedin from "~icons/ri/linkedin-box-fill";
import LogoGithub from "~icons/ri/github-fill";
import LogoInstagram from "~icons/ri/instagram-fill";
import LogoStackoverflow from "~icons/ri/stack-overflow-fill";
import LogoX from "~icons/ri/twitter-x-fill";
import ContactForm from "../ContactForm.astro";
import SectionHeader from "../SectionHeader.astro";

const socialOptions = [
  { label: "LinkedIn", link: "https://www.linkedin.com/in/frank-oppong-9286b523b/", icon: LogoLinkedin },
  { label: "GitHub", link: "https://github.com/Hackersgoddest", icon: LogoGithub },
  { label: "X", link: "https://x.com/_hackersgoddest", icon: LogoX },
  { label: "Instagram", link: "https://www.instagram.com/hackersgoddest/", icon: LogoInstagram },
  { label: "Stack Overflow", link: "https://stackoverflow.com/users/17446079/frank-oppong-konadu", icon: LogoStackoverflow },
];
const contactLink = "flex items-center gap-3 break-all text-lg hover:text-gold";
---

<section id="contact" class="py-section on-ink bg-ink text-cloth">
  <div class="container-custom">
    <SectionHeader index="05" eyebrow="Get In Touch" title="Let's Work Together" description="Ready to bring your ideas to life? Let's connect and discuss how we can create something amazing together." onInk />

    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <ContactForm />
      </div>

      <div class="lg:col-span-5">
        <h3 class="label mb-4 text-cloth-dim">Reach me directly</h3>
        <div class="mb-10 space-y-3">
          <a href="mailto:frankoppongkonadu930@gmail.com" class={contactLink}>
            <Mail size={18} class="shrink-0 text-gold" />
            frankoppongkonadu930@gmail.com
          </a>
          <a href="tel:+233256287192" class={contactLink}>
            <Phone size={18} class="shrink-0 text-gold" />
            +233 256 287 192
          </a>
        </div>

        <h3 class="label mb-4 text-cloth-dim">Connect</h3>
        <div class="flex flex-wrap gap-2">
          {
            socialOptions.map((social) => (
              <a href={social.link} target="_blank" rel="noopener noreferrer" aria-label={social.label} title={social.label} class="flex h-11 w-11 items-center justify-center border border-cloth/40 hover:border-gold hover:bg-gold hover:text-ink">
                <social.icon class="h-4 w-4" />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
