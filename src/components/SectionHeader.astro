---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  description?: string;
  /** Set on the ink-coloured sections. */
  onInk?: boolean;
}

const { index, eyebrow, title, description, onInk = false } = Astro.props;
---

<div class="mb-12 sm:mb-16">
  <div class="comb mb-8"></div>
  <div class="grid gap-6 lg:grid-cols-12 lg:items-end lg:gap-10">
    <div class="lg:col-span-7">
      <p class:list={["label mb-4", onInk ? "text-cloth-dim" : "text-ink-faint"]}>
        <span class="mr-2 bg-gold px-1.5 py-0.5 font-medium text-ink">{index}</span>{eyebrow}
      </p>
      <h2 class="text-h2">{title}</h2>
    </div>
    {description && <p class:list={["text-lg leading-relaxed lg:col-span-5", onInk ? "text-cloth-dim" : "text-ink-soft"]}>{description}</p>}
  </div>
</div>
