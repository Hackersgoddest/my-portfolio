---
// The Hackersgoddest mark: an H cut from a 3x3 grid, like a carved stamp. The
// crossbar's middle cell takes the gold. Set the cell colour with text-*.
interface Props {
  size?: number;
  class?: string;
  /** Colour of the middle cell. */
  center?: string;
}

const { size = 28, class: className, center = "var(--color-gold)" } = Astro.props;

// Each cell is a square with its corners nudged, the way a hand-cut block prints.
const cells = [
  { d: "M3 3.6 15.4 3 15 15.2 3.4 15.6Z" },
  { d: "M32.6 3.2 45 3.6 44.6 15.4 33 15Z" },
  { d: "M3.4 18 15 18.4 15.4 29.8 3 30Z" },
  { d: "M18.2 18.3 29.8 18 30 29.7 18 30Z", gold: true },
  { d: "M33 18.4 44.6 18 45 30 32.6 29.7Z" },
  { d: "M3 33 15.3 32.6 15 45 3.5 44.5Z" },
  { d: "M33 32.6 45 33 44.5 44.6 32.7 45Z" },
];
---

<svg width={size} height={size} viewBox="0 0 48 48" class={className} aria-hidden="true">
  {cells.map((cell) => <path d={cell.d} fill={cell.gold ? center : "currentColor"} />)}
</svg>
