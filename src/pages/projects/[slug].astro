---
// A full page per project: the whole description, every screenshot, and a real URL to share.
import BaseLayout from "../../layouts/BaseLayout.astro";
import projects from "../../data/projects";
import { parseDescription } from "../../utils/projectDescription";
import { projectId, slugify } from "../../utils/slug";
import { thumbnail } from "../../utils/thumbnail";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: slugify(project.title) }, props: { project } }));
}

const { project } = Astro.props;
const { intro, items, quote } = parseDescription(project.description);
const index = projects.indexOf(project);
const next = projects[(index + 1) % projects.length];
const LINK_LABELS = { site: "Visit site", code: "View code", ios: "App Store", android: "Google Play" } as const;
const cover = project.images[0];
const absolute = (url: string) => (url.startsWith("http") || url.startsWith("data:") ? url : new URL(url, "https://frankoppongkonadu.netlify.app").href);
---

<BaseLayout
  title={`${project.title} — Hackersgoddest`}
  description={intro}
  path={`/projects/${slugify(project.title)}`}
  image={cover.startsWith("data:") ? undefined : absolute(thumbnail(cover, 1200))}
>
  <main class="mx-auto w-full max-w-4xl px-4 pt-28 pb-16 sm:px-6 sm:pt-36">
    <a href={`/#${projectId(project.title)}`} class="link-gold font-medium">&larr; Back to projects</a>

    <article class="mt-8">
      <p class="label text-ink-faint">{project.category}</p>
      <h1 class="text-h2 mt-3">{project.title}</h1>
      <p class="mt-6 text-lg leading-relaxed text-ink-soft sm:text-xl">{intro}</p>

      {
        items.length > 0 && (
          <ol class="mt-8 border-t border-ink">
            {items.map((item, i) => (
              <li class="flex gap-4 border-b border-ink py-4">
                <span class="shrink-0 font-display text-2xl leading-tight text-gold-deep">{String(i + 1).padStart(2, "0")}</span>
                <span class="leading-relaxed">{item}</span>
              </li>
            ))}
          </ol>
        )
      }

      {
        quote && (
          <blockquote class="mt-8 bg-gold p-6">
            <p class="text-lg leading-relaxed">&ldquo;{quote.text}&rdquo;</p>
            <footer class="label mt-3">&mdash; {quote.attribution}</footer>
          </blockquote>
        )
      }

      <p class="mt-8 font-mono text-xs leading-relaxed text-ink-faint">{project.tools.join(" · ")}</p>

      {
        project.links.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-3">
            {project.links.map((link) => (
              <a href={link.link} target="_blank" rel="noopener noreferrer" class="bg-ink px-5 py-2.5 font-mono text-sm font-medium uppercase tracking-wider text-cloth hover:bg-gold hover:text-ink">
                {LINK_LABELS[link.type]}
              </a>
            ))}
          </div>
        )
      }
    </article>

    <section class="mt-12 space-y-6" aria-label="Screenshots">
      {
        project.images.map((image, i) => (
          <figure class="bg-cloth-deep p-3 sm:p-5">
            <img
              src={thumbnail(image, 1600)}
              alt={`${project.title}, screenshot ${i + 1} of ${project.images.length}`}
              loading={i === 0 ? "eager" : "lazy"}
              decoding="async"
              class="mx-auto max-h-[80vh] w-auto max-w-full"
            />
          </figure>
        ))
      }
    </section>

    <nav class="mt-10 flex flex-wrap items-center justify-between gap-4 font-medium" aria-label="More projects">
      <a href="/#portfolio" class="link-gold">All projects</a>
      <a href={`/projects/${slugify(next.title)}`} class="link-gold">Next: {next.title} &rarr;</a>
    </nav>
  </main>
</BaseLayout>
