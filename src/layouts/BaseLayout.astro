---
import "../assets/style.css";

interface Props {
  /** Page title; the home page's when omitted. */
  title?: string;
  description?: string;
  /** Path of this page, for the canonical URL (e.g. "/projects/memora"). */
  path?: string;
  /** Absolute URL of the social preview image. */
  image?: string;
}

const SITE_URL = "https://frankoppongkonadu.netlify.app/";
const {
  title: TITLE = "Frank Konadu Oppong — hackersgoddest",
  description: DESCRIPTION = "Frank Konadu Oppong (hackersgoddest) — full-stack & mobile engineer building web, mobile, and ML-driven products with React, Vue, Node, and Go.",
  path = "/",
  image: OG_IMAGE = `${SITE_URL}landing-page.png`,
} = Astro.props;
const SHORT_DESCRIPTION = Astro.props.description ?? "Full-stack & mobile engineer building web, mobile, and ML-driven products with React, Vue, Node, and Go.";
const PAGE_URL = new URL(path, SITE_URL).href;

// Structured data for a Person rich result
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Frank Konadu Oppong",
  alternateName: "hackersgoddest",
  url: SITE_URL,
  image: OG_IMAGE,
  jobTitle: "Software Developer",
  sameAs: [
    "https://github.com/Hackersgoddest",
    "https://www.linkedin.com/in/frank-oppong-9286b523b/",
    "https://x.com/_hackersgoddest",
    "https://www.instagram.com/hackersgoddest/",
    "https://stackoverflow.com/users/17446079/frank-oppong-konadu",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/logo.png" />
    <title>{TITLE}</title>

    <!-- Runs before first paint: marks <html> with .js so scroll-reveal
         targets start hidden (see style.css). If the motion script never
         arrives, .js is dropped again so content can't stay invisible. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let still = false;
        try {
          still = localStorage.getItem("still-mode") === "1";
        } catch {}
        if (still) root.classList.add("still");
        if (!still && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
          root.classList.add("js");
          setTimeout(() => {
            if (!root.dataset.motion) root.classList.remove("js");
          }, 4000);
        }
      })();
    </script>

    <meta name="description" content={DESCRIPTION} />
    <meta name="author" content="Frank Konadu Oppong" />
    <link rel="canonical" href={PAGE_URL} />

    <!-- Open Graph / Twitter Card -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Frank Konadu Oppong" />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={SHORT_DESCRIPTION} />
    <meta property="og:url" content={PAGE_URL} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="3570" />
    <meta property="og:image:height" content="2048" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={SHORT_DESCRIPTION} />
    <meta name="twitter:image" content={OG_IMAGE} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://res.cloudinary.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <slot />

    <!-- This static form is for Netlify form detection -->
    <form name="contact" data-netlify="true" data-netlify-honeypot="bot-field" hidden>
      <input type="text" name="name" />
      <input type="email" name="email" />
      <input type="text" name="subject" />
      <textarea name="message"></textarea>
    </form>
  </body>
</html>
