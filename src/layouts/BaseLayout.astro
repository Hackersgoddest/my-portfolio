---
import { Font } from "astro:assets";
import "../assets/style.css";
import MenuBar from "../components/MenuBar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  /** Page title; the home page's when omitted. */
  title?: string;
  description?: string;
  /** Path of this page, for the canonical URL (e.g. "/projects/memora"). */
  path?: string;
  /** Absolute URL of the social preview image. */
  image?: string;
}

const SITE_URL = "https://frankoppongkonadu.netlify.app/";
const {
  title: TITLE = "Hackersgoddest — Frank Konadu Oppong",
  description: DESCRIPTION = "Hackersgoddest is Frank Konadu Oppong, a software engineer and ML researcher in Accra building web, mobile, and ML-driven products with React, Vue, Node, and Go.",
  path = "/",
  image: OG_IMAGE = `${SITE_URL}og.png`,
} = Astro.props;
const SHORT_DESCRIPTION = Astro.props.description ?? "Software engineer and ML researcher in Accra, building web, mobile, and ML-driven products.";
const PAGE_URL = new URL(path, SITE_URL).href;

// Structured data for a Person rich result
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Frank Konadu Oppong",
  alternateName: "Hackersgoddest",
  url: SITE_URL,
  image: OG_IMAGE,
  jobTitle: "Software Developer",
  sameAs: [
    "https://github.com/Hackersgoddest",
    "https://www.linkedin.com/in/frank-oppong-9286b523b/",
    "https://x.com/_hackersgoddest",
    "https://www.instagram.com/hackersgoddest/",
    "https://stackoverflow.com/users/17446079/frank-oppong-konadu",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="only light" />
    <meta name="theme-color" content="#f6efe1" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png?v=2" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{TITLE}</title>

    <Font cssVariable="--font-ga-maamli" preload />
    <Font cssVariable="--font-hanken" preload />
    <Font cssVariable="--font-dm-mono" />

    <meta name="description" content={DESCRIPTION} />
    <meta name="author" content="Frank Konadu Oppong" />
    <link rel="canonical" href={PAGE_URL} />

    <!-- Open Graph / Twitter Card -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hackersgoddest" />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={SHORT_DESCRIPTION} />
    <meta property="og:url" content={PAGE_URL} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={SHORT_DESCRIPTION} />
    <meta name="twitter:image" content={OG_IMAGE} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />

    <link rel="preconnect" href="https://res.cloudinary.com" />
  </head>
  <body class="min-w-80">
    <MenuBar />
    <slot />
    <Footer />
  </body>
</html>
